#!/usr/bin/env sh
# 预推送钩子 - 推送前第3位（patch）+1（部署版本）
# 仅推送到 main 分支时触发

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$BRANCH" != "main" ]; then
    echo "⏭️  非 main 分支，跳过部署版本更新"
    exit 0
fi

# 检查是否有可推送的提交
if ! git log origin/main..HEAD --oneline 2>/dev/null | grep -q .; then
    echo "⏭️  没有新提交需要推送，跳过"
    exit 0
fi

echo "🚀 检测到 main 分支推送，部署版本更新..."

VERSION_FILE="package.json"

get_version() {
    grep '"version"' "$VERSION_FILE" | sed 's/.*"version": "\([^"]*\)".*/\1/'
}

bump_patch() {
    local version=$1
    local major=$(echo $version | cut -d'.' -f1)
    local minor=$(echo $version | cut -d'.' -f2)
    local patch=$(echo $version | cut -d'.' -f3)
    local new_patch=$((patch + 1))
    echo "${major}.${minor}.${new_patch}"
}

OLD_VERSION=$(get_version)
NEW_VERSION=$(bump_patch $OLD_VERSION)

# 使用 Perl 进行替换（macOS 兼容）
perl -i -pe "s/\"version\": \"$OLD_VERSION\"/\"version\": \"$NEW_VERSION\"/" "$VERSION_FILE"

echo "📦 部署版本更新: $OLD_VERSION -> $NEW_VERSION"

# 提交版本更新
git add "$VERSION_FILE"
git commit -m "chore: 部署版本更新 $NEW_VERSION"

echo "✅ 版本更新完成，推送继续..."
