# 应用配置
VITE_APP_NAME=NanoAiCanvas
VITE_APP_VERSION=0.1.0
VITE_APP_DESCRIPTION=无限画布应用 - 基于 React Flow 的节点编辑器

# API 配置（预留云端接口）
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# MiniMax API 配置
VITE_MINIMAX_API_KEY=sk-cp-your-api-key

# 速创API配置（GPT-Image-2）
VITE_WUYIN_API_KEY=your-wuyin-api-key

# 功能开关
VITE_ENABLE_CLOUD_SYNC=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# 存储配置
VITE_AUTOSAVE_INTERVAL=30000
VITE_MAX_STORAGE_SIZE=50

# 国际化
VITE_DEFAULT_LOCALE=zh-CN
VITE_SUPPORTED_LOCALES=zh-CN,en-US

# 其他配置
VITE_MAX_NODES=1000
VITE_MAX_EDGES=2000
