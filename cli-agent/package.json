{
  "name": "nanoai-video-compose",
  "version": "0.1.0",
  "description": "AI-powered video composition CLI — FFmpeg pipeline + MCP Server + Agent chat",
  "type": "module",
  "bin": {
    "nanoai-video": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "mcp": "tsx src/index.ts mcp",
    "serve": "tsx src/index.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "fastify": "^5.3.3",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
